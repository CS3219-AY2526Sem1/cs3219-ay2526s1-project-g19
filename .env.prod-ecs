# -----------------------------------------------------------------------------
# Service-to-Service URLs (ECS Internal - Service Discovery)
# -----------------------------------------------------------------------------
# ⚠️  Replace NAMESPACE with Terraform output: terraform output service_discovery_namespace
#     Example: peerprep-production.local

USER_SERVICE_URL=http://user-service.peerprep-prod.local:8000
QUESTION_SERVICE_URL=http://question-service.peerprep-prod.local:8000
MATCHING_SERVICE_URL=http://matching-service.peerprep-prod.local:8000
SESSION_SERVICE_URL=http://session-service.peerprep-prod.local:8000
EXECUTION_SERVICE_URL=http://execution-service.peerprep-prod.local:8000
COLLABORATION_SERVICE_URL=http://collaboration-service.peerprep-prod.local:8000
CHAT_SERVICE_URL=http://chat-service.peerprep-prod.local:8000
HISTORY_SERVICE_URL=http://session-service.peerprep-prod.local:8000

# -----------------------------------------------------------------------------
# Kafka Configuration (ECS Internal - Service Discovery)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka.peerprep-prod.local:29092
SCHEMA_REGISTRY_URL=http://schema-registry.peerprep-prod.local:8081

# Kafka Topics
TOPIC_MATCH_FOUND=match.found
TOPIC_QUESTION_CHOSEN=question.chosen
TOPIC_SESSION_CREATED=session.created
TOPIC_SESSION_END=session.end

# Kafka Consumer Groups
QUESTION_GROUP_ID=question-service-group
MATCHING_GROUP_ID=matching-service-group
SESSION_GROUP_ID=session-service-group

# Kafka Credentials (if using SASL - optional)
SASL_USERNAME=
SASL_PASSWORD=

# -----------------------------------------------------------------------------
# Judge0 Configuration (External API)
# -----------------------------------------------------------------------------
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=CHANGEME_JUDGE0_API_KEY

# -----------------------------------------------------------------------------
# Email Configuration (Gmail SMTP)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=peerprepg19@gmail.com
EMAIL_HOST_PASSWORD=CHANGEME_GMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=peerprepg19@gmail.com
EMAIL_SSO_CALLBACK_PATH=/auth/email-sso
EMAIL_SSO_TOKEN_TTL_MINUTES=15
EMAIL_SSO_SUBJECT=[PeerPrep] Sign in link

# -----------------------------------------------------------------------------
# Frontend Configuration (Public ALB URL)
# -----------------------------------------------------------------------------
# ⚠️  Get ALB DNS from: terraform output alb_dns_name
FRONTEND_BASE_URL=http://peerprep-prod-alb-782414665.ap-southeast-1.elb.amazonaws.com

# Frontend Build Variables (VITE)
NODE_ENV=production
VITE_QUESTION_SERVICE_URL=/question-service-api
VITE_MATCHING_SERVICE_URL=/matching-service-api
VITE_USER_SERVICE_URL=/user-service-api
VITE_SESSION_SERVICE_URL=/session-service-api
VITE_EXECUTION_SERVICE_URL=/execution-service-api
VITE_COLLABORATION_SERVICE_URL=/collaboration-service-api
VITE_CHAT_SERVICE_URL=/chat-service-api

# Nginx Proxy Configuration (Backend Hosts)
NGINX_USER_SERVICE_HOST=user-service.peerprep-prod.local
NGINX_QUESTION_SERVICE_HOST=question-service.peerprep-prod.local
NGINX_MATCHING_SERVICE_HOST=matching-service.peerprep-prod.local
NGINX_SESSION_SERVICE_HOST=session-service.peerprep-prod.local
NGINX_EXECUTION_SERVICE_HOST=execution-service.peerprep-prod.local
NGINX_COLLABORATION_SERVICE_HOST=collaboration-service.peerprep-prod.local
NGINX_CHAT_SERVICE_HOST=chat-service.peerprep-prod.local

# -----------------------------------------------------------------------------
# Service-Specific Configuration
# -----------------------------------------------------------------------------
PORT=8000
SERVICE_PREFIX=/api
SKIP_DB_SETUP=true

# =============================================================================
# QUICK FILL GUIDE
# =============================================================================
# After running `terraform apply` for the first time, run these commands to get values:
#
# 1. Get Service Discovery Namespace:
#    NAMESPACE=$(terraform output -raw service_discovery_namespace)
#    sed -i '' "s/peerprep-prod.local/$NAMESPACE/g" .env.prod-ecs
#
# 2. Get Database Endpoints:
#    terraform output | grep db_endpoint
#    # Copy each endpoint and replace CHANGEME_RDS_*_ENDPOINT
#
# 3. Get Redis Endpoints:
#    terraform output | grep redis_endpoint
#    # Copy each endpoint and replace CHANGEME_ELASTICACHE_*_ENDPOINT
#
# 4. Get ALB DNS:
#    terraform output -raw alb_dns_name
#    # Replace peerprep-prod-alb-782414665.ap-southeast-1.elb.amazonaws.com
#
# 5. Re-upload secrets:
#    cd terraform && ./scripts/upload-secrets-to-aws.sh ../.env.prod-ecs production us-east-1
#
# 6. Force ECS to redeploy with new secrets:
#    terraform apply -var="force_new_deployment=true"
# =============================================================================

