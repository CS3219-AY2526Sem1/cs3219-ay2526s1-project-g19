DB_HOST=peerprep-prod-user-postgres.cfg64820wjva.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=user_db
DB_USER=peerprep_admin
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
