QUESTION_DB_PORT=5432
QUESTION_DB_NAME=question_db
QUESTION_DB_USER=peerprep_admin
QUESTION_DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
QUESTION_DATABASE_URL=postgresql://peerprep_admin:CHANGE_ME_SECURE_PASSWORD_HERE@peerprep-prod-question-postgres.cfg64820wjva.ap-southeast-1.rds.amazonaws.com:5432/question_db
DJANGO_USE_SQLITE=0

# Matching Service Database
MATCHING_DB_HOST=peerprep-prod-matching-postgres.cfg64820wjva.ap-southeast-1.rds.amazonaws.com
