# =============================================================================
# PeerPrep ECS Production Environment Configuration
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.prod-ecs.template .env.prod-ecs
#   2. Fill in ALL values below (replace CHANGEME placeholders)
#   3. Upload to AWS: cd terraform && ./scripts/upload-secrets-to-aws.sh ../.env.prod-ecs production us-east-1
#   4. Deploy: terraform apply
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Type
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# -----------------------------------------------------------------------------
# Security - CHANGE THESE!
# -----------------------------------------------------------------------------
SECRET_KEY=eBvGXd1G_Utf94ypL-tpPr3xVtapbJwZtW0bdpy9TYLcDOiC6SmOD_EyzCV9NkEcvwE
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# Database Configuration (ECS Production - RDS Endpoints)
# -----------------------------------------------------------------------------
# ⚠️  Get these from Terraform outputs AFTER first apply:
#     terraform output | grep db_endpoint

# User Service Database
USER_DB_HOST=peerprep-prod-user-postgres.cfg64820wjva.ap-southeast-1.rds.amazonaws.com
USER_DB_PORT=5432
USER_DB_NAME=user_db
USER_DB_USER=peerprep_admin
USER_DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
USER_DATABASE_URL=postgresql://peerprep_admin:CHANGE_ME_SECURE_PASSWORD_HERE@peerprep-prod-user-postgres.cfg64820wjva.ap-southeast-1.rds.amazonaws.com:5432/user_db

# Question Service Database
