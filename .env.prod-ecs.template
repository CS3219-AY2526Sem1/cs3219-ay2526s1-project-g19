# =============================================================================
# PeerPrep ECS Production Environment Configuration
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.prod-ecs.template .env.prod-ecs
#   2. Fill in ALL values below (replace CHANGEME placeholders)
#   3. Upload to AWS: cd terraform && ./scripts/upload-secrets-to-aws.sh ../.env.prod-ecs production us-east-1
#   4. Deploy: terraform apply
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Type
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# -----------------------------------------------------------------------------
# Security - CHANGE THESE!
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGEME_GENERATE_RANDOM_SECRET_KEY
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# Database Configuration (ECS Production - RDS Endpoints)
# -----------------------------------------------------------------------------
# ⚠️  Get these from Terraform outputs AFTER first apply:
#     terraform output | grep db_endpoint

# User Service Database
USER_DB_HOST=CHANGEME_RDS_USER_ENDPOINT
USER_DB_PORT=5432
USER_DB_NAME=user_db
USER_DB_USER=CHANGEME_DB_USERNAME
USER_DB_PASSWORD=CHANGEME_DB_PASSWORD
USER_DATABASE_URL=postgresql://CHANGEME_DB_USERNAME:CHANGEME_DB_PASSWORD@CHANGEME_RDS_USER_ENDPOINT:5432/user_db

# Question Service Database
QUESTION_DB_HOST=CHANGEME_RDS_QUESTION_ENDPOINT
QUESTION_DB_PORT=5432
QUESTION_DB_NAME=question_db
QUESTION_DB_USER=CHANGEME_DB_USERNAME
QUESTION_DB_PASSWORD=CHANGEME_DB_PASSWORD
QUESTION_DATABASE_URL=postgresql://CHANGEME_DB_USERNAME:CHANGEME_DB_PASSWORD@CHANGEME_RDS_QUESTION_ENDPOINT:5432/question_db
DJANGO_USE_SQLITE=0

# Matching Service Database
MATCHING_DB_HOST=CHANGEME_RDS_MATCHING_ENDPOINT
MATCHING_DB_PORT=5432
MATCHING_DB_NAME=matching_db
MATCHING_DB_USER=CHANGEME_DB_USERNAME
MATCHING_DB_PASSWORD=CHANGEME_DB_PASSWORD
MATCHING_DATABASE_URL=postgresql://CHANGEME_DB_USERNAME:CHANGEME_DB_PASSWORD@CHANGEME_RDS_MATCHING_ENDPOINT:5432/matching_db

# Session Service Database
SESSION_DB_HOST=CHANGEME_RDS_SESSION_ENDPOINT
SESSION_DB_PORT=5432
SESSION_DB_NAME=session_db
SESSION_DB_USER=CHANGEME_DB_USERNAME
SESSION_DB_PASSWORD=CHANGEME_DB_PASSWORD
SESSION_DB_SSL_MODE=CHANGEME_DB_SSL_MODE
SESSION_DATABASE_URL=postgresql://CHANGEME_DB_USERNAME:CHANGEME_DB_PASSWORD@CHANGEME_RDS_SESSION_ENDPOINT:5432/session_db

# -----------------------------------------------------------------------------
# Redis Configuration (ECS Production - ElastiCache Endpoints)
# -----------------------------------------------------------------------------
# ⚠️  Get these from Terraform outputs AFTER first apply:
#     terraform output | grep redis_endpoint

# Matching Redis
MATCHING_REDIS_HOST=CHANGEME_ELASTICACHE_MATCHING_ENDPOINT
MATCHING_REDIS_PORT=6379
MATCHING_REDIS_URL=redis://CHANGEME_ELASTICACHE_MATCHING_ENDPOINT:6379/0

# Collaboration Redis
COLLABORATION_REDIS_HOST=CHANGEME_ELASTICACHE_COLLABORATION_ENDPOINT
COLLABORATION_REDIS_PORT=6379
COLLABORATION_REDIS_URL=redis://CHANGEME_ELASTICACHE_COLLABORATION_ENDPOINT:6379/0

# Chat Redis
CHAT_REDIS_HOST=CHANGEME_ELASTICACHE_CHAT_ENDPOINT
CHAT_REDIS_PORT=6379
CHAT_REDIS_URL=redis://CHANGEME_ELASTICACHE_CHAT_ENDPOINT:6379/0

# Generic (used by some services)
REDIS_HOST=CHANGEME_ELASTICACHE_ENDPOINT
REDIS_PORT=6379
REDIS_URL=redis://CHANGEME_ELASTICACHE_ENDPOINT:6379/0

# -----------------------------------------------------------------------------
# Service-to-Service URLs (ECS Internal - Service Discovery)
# -----------------------------------------------------------------------------
# ⚠️  Replace NAMESPACE with Terraform output: terraform output service_discovery_namespace
#     Example: peerprep-production.local

USER_SERVICE_URL=http://user-service.CHANGEME_NAMESPACE:8000
QUESTION_SERVICE_URL=http://question-service.CHANGEME_NAMESPACE:8000
MATCHING_SERVICE_URL=http://matching-service.CHANGEME_NAMESPACE:8000
SESSION_SERVICE_URL=http://session-service.CHANGEME_NAMESPACE:8000
EXECUTION_SERVICE_URL=http://execution-service.CHANGEME_NAMESPACE:8000
COLLABORATION_SERVICE_URL=http://collaboration-service.CHANGEME_NAMESPACE:8000
CHAT_SERVICE_URL=http://chat-service.CHANGEME_NAMESPACE:8000
HISTORY_SERVICE_URL=http://session-service.CHANGEME_NAMESPACE:8000

# -----------------------------------------------------------------------------
# Kafka Configuration (ECS Internal - Service Discovery)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka.CHANGEME_NAMESPACE:29092
SCHEMA_REGISTRY_URL=http://schema-registry.CHANGEME_NAMESPACE:8081

# Kafka Topics
TOPIC_MATCH_FOUND=match.found
TOPIC_QUESTION_CHOSEN=question.chosen
TOPIC_SESSION_CREATED=session.created
TOPIC_SESSION_END=session.end
TOPIC_TOPICS_UPDATED=topics.updated
TOPIC_DIFFICULTIES_UPDATED=difficulties.updated

# Kafka Consumer Groups
QUESTION_GROUP_ID=question-service-group
MATCHING_GROUP_ID=matching-service-group
SESSION_GROUP_ID=session-service-group

# Kafka Schema Registry Credentials
SCHEMA_REGISTRY_KEY=CHANGEME_SCHEMA_REGISTRY_KEY
SCHEMA_REGISTRY_SECRET=CHANGEME_SCHEMA_REGISTRY_SECRET

# Kafka Credentials (if using SASL - optional)
SASL_USERNAME=CHANGEME_SASL_USERNAME
SASL_PASSWORD=CHANGEME_SASL_PASSWORD

# -----------------------------------------------------------------------------
# Judge0 Configuration (External API)
# -----------------------------------------------------------------------------
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=CHANGEME_JUDGE0_API_KEY

# -----------------------------------------------------------------------------
# Email Configuration (Gmail SMTP)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=peerprepg19@gmail.com
EMAIL_HOST_PASSWORD=CHANGEME_GMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=peerprepg19@gmail.com
EMAIL_SSO_CALLBACK_PATH=/auth/email-sso
EMAIL_SSO_TOKEN_TTL_MINUTES=15
EMAIL_SSO_SUBJECT=[PeerPrep] Sign in link

# -----------------------------------------------------------------------------
# Frontend Configuration (Public ALB URL)
# -----------------------------------------------------------------------------
# ⚠️  Get ALB DNS from: terraform output alb_dns_name
FRONTEND_BASE_URL=http://CHANGEME_ALB_DNS_NAME

# Frontend Build Variables (VITE)
NODE_ENV=production
VITE_QUESTION_SERVICE_URL=/question-service-api
VITE_MATCHING_SERVICE_URL=/matching-service-api
VITE_USER_SERVICE_URL=/user-service-api
VITE_SESSION_SERVICE_URL=/session-service-api
VITE_EXECUTION_SERVICE_URL=/execution-service-api
VITE_COLLABORATION_SERVICE_URL=/collaboration-service-api
VITE_CHAT_SERVICE_URL=/chat-service-api

# Nginx Proxy Configuration (Backend Hosts)
NGINX_USER_SERVICE_HOST=user-service.CHANGEME_NAMESPACE
NGINX_QUESTION_SERVICE_HOST=question-service.CHANGEME_NAMESPACE
NGINX_MATCHING_SERVICE_HOST=matching-service.CHANGEME_NAMESPACE
NGINX_SESSION_SERVICE_HOST=session-service.CHANGEME_NAMESPACE
NGINX_EXECUTION_SERVICE_HOST=execution-service.CHANGEME_NAMESPACE
NGINX_COLLABORATION_SERVICE_HOST=collaboration-service.CHANGEME_NAMESPACE
NGINX_CHAT_SERVICE_HOST=chat-service.CHANGEME_NAMESPACE

# -----------------------------------------------------------------------------
# Service-Specific Configuration
# -----------------------------------------------------------------------------
PORT=8000
SERVICE_PREFIX=/api
SKIP_DB_SETUP=false

# Service-specific API prefixes
USER_SERVICE_PREFIX=/user-service-api
QUESTION_SERVICE_PREFIX=/question-service-api
MATCHING_SERVICE_PREFIX=/matching-service-api
SESSION_SERVICE_PREFIX=/session-service-api
EXECUTION_SERVICE_PREFIX=/execution-service-api
COLLABORATION_SERVICE_PREFIX=/collaboration-service-api
CHAT_SERVICE_PREFIX=/chat-service-api

# =============================================================================
# QUICK FILL GUIDE
# =============================================================================
# After running `terraform apply` for the first time, run these commands to get values:
#
# 1. Get Service Discovery Namespace:
#    NAMESPACE=$(terraform output -raw service_discovery_namespace)
#    sed -i '' "s/CHANGEME_NAMESPACE/$NAMESPACE/g" .env.prod-ecs
#
# 2. Get Database Endpoints:
#    terraform output | grep db_endpoint
#    # Copy each endpoint and replace CHANGEME_RDS_*_ENDPOINT
#
# 3. Get Redis Endpoints:
#    terraform output | grep redis_endpoint
#    # Copy each endpoint and replace CHANGEME_ELASTICACHE_*_ENDPOINT
#
# 4. Get ALB DNS:
#    terraform output -raw alb_dns_name
#    # Replace CHANGEME_ALB_DNS_NAME
#
# 5. Re-upload secrets:
#    cd terraform && ./scripts/upload-secrets-to-aws.sh ../.env.prod-ecs production us-east-1
#
# 6. Force ECS to redeploy with new secrets:
#    terraform apply -var="force_new_deployment=true"
# =============================================================================
